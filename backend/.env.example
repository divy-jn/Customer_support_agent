# ─────────────────────────────────────────────
#  IntelliSupport Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file to Git.
# ─────────────────────────────────────────────

# ── Supabase (PostgreSQL) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>
DATABASE_PASSWORD=

# ── Cloud LLM (Ollama Cloud) ──
# Available models: nemotron-3-super, nemotron-3-ultra, gpt-oss:120b, gpt-oss:20b, gemma4:31b
LLM_BASE_URL=https://ollama.com/v1
LLM_SMALL_MODEL=nemotron-3-super
LLM_LARGE_MODEL=nemotron-3-super
LLM_FALLBACK_MODEL=gpt-oss:120b
LLM_API_KEY=<your-ollama-cloud-api-key>
LLM_TIMEOUT=120

# ── Pinecone (Vector DB for RAG) ──
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=knowledge-base

# ── Upstash Redis (Optional — session store) ──
# If not set, in-memory session store is used (fine for local dev)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Knowledge Base ──
KNOWLEDGE_BASE_DIR=./knowledge_base

# ── FastAPI Server ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Logging ──
LOG_LEVEL=INFO
DEBUG_MODE=false

# ── Email (Optional — for ticket notifications) ──
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FROM_EMAIL=noreply@intellisupport.ai
SUPPORT_TEAM_EMAIL=support@intellisupport.ai
TECH_TEAM_EMAIL=tech@intellisupport.ai

# ── LangSmith (Optional — for LLM tracing) ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=intellisupport-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── WebSocket ──
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_SESSION=5
WS_MESSAGE_RATE_LIMIT=20

# ── LangGraph ──
LANGGRAPH_TIMEOUT=60

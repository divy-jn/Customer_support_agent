# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the values before running the application.
# Do NOT commit the .env file containing real secrets to version control.
# Use development locally; staging/production reject DEBUG_MODE=true and require real credentials.
APP_ENVIRONMENT="development"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# Optional direct PostgreSQL credential for the durable outbox/reconciliation workers.
# This is the database password from Supabase Database settings, NOT SUPABASE_KEY.
DATABASE_PASSWORD=""

# ------------------------------------------------------------------------------
# 2. PINECONE CONFIGURATION (Vector Database for RAG)
# ------------------------------------------------------------------------------
# Get these from your Pinecone Dashboard
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="your-index-name"

# ------------------------------------------------------------------------------
# 3. LLM CONFIGURATION (Google Cloud Vertex AI)
# ------------------------------------------------------------------------------
# Uses Application Default Credentials (ADC) — no API key needed.
# Run: gcloud auth application-default login
LLM_MODEL="gemini-3.8-flash"
LLM_TIMEOUT="120"
VERTEX_PROJECT_ID="your-gcp-project-id"
VERTEX_LOCATION="global"

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION
# ------------------------------------------------------------------------------
# Must be a long, secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET="your-secure-jwt-secret-key-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES="1440"

# Optional static Agent Dashboard token (local development only).
# Outside DEBUG_MODE, any configured AGENT_SECRET / ADMIN_API_KEY must be a strong 32+ character random secret.
AGENT_SECRET="test-agent-secret"
ADMIN_API_KEY=""

# Enable development login endpoints (skip JWT validation for local testing)
DEBUG_MODE="True"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Optional - Used for Mock/Real SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="support@yourcompany.com"

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Origins allowed to connect via CORS (Next.js frontend)
CORS_ORIGINS="http://localhost:3003,http://127.0.0.1:3003"
FRONTEND_URL="http://localhost:3003"
API_PORT="8002"

# Architecture rollout mode. Keep `legacy` until the V2 Product/Warranty
# vertical slice has passed its evaluation gate. In `v2_product`, product
# requests run semantic router → supervisor → ProductAgent → Guardian →
# response composer. `v2_product_order` also enables safe Order tracking and
# confirmation-gated cancellation. `v2_core` additionally enables payment
# record verification and the confirmation-gated refund path; payment disputes
# remain Guardian-controlled.
# `v2_all` additionally migrates read-only General FAQ/policy support through
# the approved knowledge base. Keep the default `legacy` until evaluation passes.
AGENT_ARCHITECTURE_MODE="legacy"

# ------------------------------------------------------------------------------
# 7. HIGH-RISK ACTION APPROVAL SIGNING (V2 Mutation Boundary)
# ------------------------------------------------------------------------------
# Dedicated persistent secret for HMAC-SHA256 cryptographic binding of pending
# mutation approvals (order cancellations, refunds).
# Must be a long, high-entropy secret string in production (e.g., openssl rand -hex 32).
# Never silently reuse JWT_SECRET or AGENT_SECRET, and never use a hardcoded default.
# If absent or invalid, approval creation and execution fail closed.
#
# Key Rotation Implications:
# Changing APPROVAL_SIGNING_SECRET will invalidate all pending, unexecuted approval
# signatures created prior to the rotation. Any in-flight confirmation attempts will
# be safely rejected and require re-authorization.
APPROVAL_SIGNING_SECRET="your-dedicated-approval-signing-secret-change-me"

# ─────────────────────────────────────────────
#  IntelliSupport Backend — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Supabase PostgreSQL
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>
DATABASE_PASSWORD=

# Cloud LLM
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_SMALL_MODEL=gpt-oss:20b-cloud
LLM_LARGE_MODEL=gpt-oss:120b-cloud
LLM_API_KEY=<your-api-key>

# Pinecone
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=knowledge-base

# Upstash Redis
UPSTASH_REDIS_URL=<your-upstash-url>
UPSTASH_REDIS_TOKEN=<your-upstash-token>

# Knowledge Base
KNOWLEDGE_BASE_DIR=./knowledge_base

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@intellisupport.ai
SUPPORT_TEAM_EMAIL=support@intellisupport.ai
TECH_TEAM_EMAIL=tech@intellisupport.ai

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=intellisupport-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_SESSION=5
WS_MESSAGE_RATE_LIMIT=20

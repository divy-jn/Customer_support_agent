# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the values before running the application.
# Do NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# ------------------------------------------------------------------------------
# 2. PINECONE CONFIGURATION (Vector Database for RAG)
# ------------------------------------------------------------------------------
# Get these from your Pinecone Dashboard
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="your-index-name"
# Example namespace if you partition data, otherwise leave blank or 'default'
PINECONE_NAMESPACE="default"

# ------------------------------------------------------------------------------
# 3. LLM CONFIGURATION (Google Gemini API)
# ------------------------------------------------------------------------------
# Google Gemini API key
LLM_PROVIDER="google"
LLM_API_KEY="your-gemini-api-key"
# Base URL for the LLM API (e.g. https://api.openai.com/v1 or https://generativelanguage.googleapis.com/v1beta/openai)
# LLM_BASE_URL=""
# Models
LLM_LARGE_MODEL="gemini-1.5-pro-latest"
LLM_SMALL_MODEL="gemini-1.5-flash-latest"

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION
# ------------------------------------------------------------------------------
# Must be a long, secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET="your-secure-jwt-secret-key-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES="1440"

# Static token for Agent Dashboard access (demo purposes only)
AGENT_SECRET="test-agent-secret"

# Enable development login endpoints (skip JWT validation for local testing)
DEBUG_MODE="True"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Optional - Used for Mock/Real SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="support@yourcompany.com"

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Origins allowed to connect via CORS (Frontend URL)
FRONTEND_URL="http://localhost:3003"

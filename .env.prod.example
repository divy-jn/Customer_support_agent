# Copy this file to .env.prod and replace the placeholders. Restrict its permissions.
# Leave APP_DOMAIN empty to serve HTTP for smoke checks on the static IP.
# After DNS points to the static IP, set the bare hostname and switch the URLs to HTTPS/WSS.
# Use HTTPS for sign-ins and authenticated traffic.
APP_DOMAIN=
NEXT_PUBLIC_API_URL=http://192.0.2.10
NEXT_PUBLIC_WS_URL=ws://192.0.2.10
CORS_ORIGINS=http://192.0.2.10
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anon-key

APP_ENVIRONMENT=production
DEBUG_MODE=false
AGENT_ARCHITECTURE_MODE=v2_all
MCP_DB_STAFF_MODE=true
HTTP_RATE_LIMIT_STORAGE_URI=memory://
LLM_PROVIDER=bedrock
LLM_MODEL=deepseek.v3.2
LLM_TIMEOUT=120
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-the-public-anon-key
SUPABASE_KEY=replace-with-the-server-service-role-key
# For IPv4-only hosts, use Supabase's session pooler DSN with sslmode=require.
DATABASE_URL=
DATABASE_PASSWORD=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowledge-base

JWT_SECRET=
APPROVAL_SIGNING_SECRET=
ADMIN_API_KEY=
AGENT_SECRET=

# Email dispatch and reconciliation start by default. Set OUTBOX_WORKER_ENABLED=false to disable both.
OUTBOX_WORKER_ENABLED=true
SUPPORT_TEAM_EMAIL=support@your-domain.invalid
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FROM_EMAIL=
EMAIL_TEST_RECIPIENT=
